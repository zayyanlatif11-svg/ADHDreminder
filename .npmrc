# Fail fast on an unsupported Node version.
#
# better-sqlite3 only publishes prebuilt binaries for LTS lines, and its source
# does not compile against the V8 headers in newer "Current" releases. Without
# this, an unsupported Node produces a few hundred lines of C++ compiler errors
# and a half-finished install; with it, npm stops immediately and names the
# actual problem.
engine-strict=true
