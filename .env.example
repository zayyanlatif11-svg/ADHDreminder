# execution-agent configuration
#
# Copy this file to `.env` and fill it in:   cp .env.example .env
# `npm run setup` will fill most of it in for you interactively.
#
# NEVER commit .env — it is already in .gitignore.

# ─────────────────────────────────────────────────────────────────────────────
# Local service
# ─────────────────────────────────────────────────────────────────────────────
PORT=4711
HOST=127.0.0.1
LOG_LEVEL=info

# Local operational database (webhook dedupe, message state). Not your tasks.
DATA_DIR=./data

# Set to true to run everything without actually sending iMessages.
DRY_RUN=false

# ─────────────────────────────────────────────────────────────────────────────
# BlueBubbles (the iMessage bridge)
#
# Install the BlueBubbles Server app on this Mac. Keep System Integrity
# Protection ON — this project does not use any Private API feature.
# ─────────────────────────────────────────────────────────────────────────────
BLUEBUBBLES_SERVER_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=

# apple-script works with SIP enabled. Leave this alone unless you know why.
BLUEBUBBLES_SEND_METHOD=apple-script

# Shared secret appended to the webhook URL you paste into BlueBubbles.
# `npm run setup` generates one for you.
WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# iMessage identity
#
# AUTHORIZED_USER_HANDLE — the address you send commands FROM. Anything from a
#                          different address is ignored entirely.
# TARGET_HANDLE          — the address the agent sends TO.
# CHAT_GUID              — optional. Pins replies to one exact conversation.
#
# Read the "iMessage identity" section of SETUP.md before assuming that texting
# yourself from the same Apple ID will work — it usually will not.
# ─────────────────────────────────────────────────────────────────────────────
AUTHORIZED_USER_HANDLE=
TARGET_HANDLE=
CHAT_GUID=
ADDITIONAL_AUTHORIZED_HANDLES=

# ─────────────────────────────────────────────────────────────────────────────
# Google (Sheets = your task list, Calendar = your schedule)
# SETUP.md step 5 walks through creating these.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4712/oauth2callback
GOOGLE_TOKEN_PATH=./secrets/google-token.json

# The spreadsheet that holds TASKS / COURSES / CONFIG. `npm run setup` can
# create this for you.
SPREADSHEET_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Calendars
#
# CALENDAR_SOURCES accepts any combination of:
#   google — your Google account's calendars
#   apple  — the macOS Calendar app (covers iCloud, Exchange, and any account
#            you have added to your Mac, including subscribed feeds)
#   ics    — any .ics feed URL or local file (a Canvas export, for example)
#
# Events found in more than one source are automatically de-duplicated.
# ─────────────────────────────────────────────────────────────────────────────
CALENDAR_SOURCES=google,apple

# Blank = your primary Google calendar only.
GOOGLE_CALENDAR_IDS=

# Blank = every calendar the macOS Calendar app knows about.
APPLE_CALENDAR_NAMES=

# Comma-separated .ics URLs or file paths.
ICS_CALENDAR_URLS=

# Generated study blocks are written ONLY to this dedicated calendar, never to
# your real one. Set STUDY_BLOCK_TARGET to google or apple to enable writing,
# and also switch study_block_calendar_enabled to true in the CONFIG tab.
STUDY_BLOCK_CALENDAR_NAME=Execution Agent
STUDY_BLOCK_TARGET=none

# ─────────────────────────────────────────────────────────────────────────────
# Optional LLM
#
# Everything works without this. Leave LLM_PROVIDER=none unless you want the
# agent to rewrite vague tasks into concrete first actions.
# The LLM never decides priorities, deadlines, or completion.
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
